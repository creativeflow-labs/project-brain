APP_NAME=Project Brain
DATABASE_URL=postgresql+psycopg://projectbrain:projectbrain@db:5432/projectbrain
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20

# 비워두면 로컬 결정적 임베딩 + 추출형 답변으로 동작합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# 검색 코어 기본값. 실제 회귀 점수 측정 전에는 과도하게 줄이지 마세요.
SEARCH_CANDIDATE_LIMIT=80
SEARCH_RERANK_LIMIT=36
SEARCH_EVIDENCE_LIMIT=12
SEARCH_SCOPED_RECORD_LIMIT=100
SEARCH_PARENT_MAX_CHARS=12000
SEARCH_HISTORY_MESSAGES=8
SEARCH_MAX_RETRIES=1

# Notion 연결·동기화 설정
NOTION_VERSION=2026-03-11
NOTION_MAX_PAGES_PER_SYNC=2000
NOTION_SCHEDULER_POLL_SECONDS=60

# Gmail OAuth 설정. Google Cloud의 OAuth 클라이언트 정보와 일치해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/gmail/callback

# 연결 토큰 암호화 키. 비워두면 data/secrets에 로컬 키를 자동 생성합니다.
# 직접 관리하려면 아래 명령으로 생성:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_FILE=/app/data/secrets/token-encryption.key
