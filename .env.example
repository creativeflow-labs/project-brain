APP_NAME=Project Brain
DATABASE_URL=postgresql+psycopg://projectbrain:projectbrain@db:5432/projectbrain
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20

# 비워두면 로컬 결정적 임베딩 + 추출형 답변으로 동작합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Notion 통합 토큰은 UI에서 일회성으로 입력합니다.
NOTION_VERSION=2025-09-03

# Gmail OAuth 설정. Google Cloud의 OAuth 클라이언트 정보와 일치해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/gmail/callback

# OAuth 토큰 암호화 키. 아래 명령으로 생성:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
